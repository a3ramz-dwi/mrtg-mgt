APP_DIR="/var/www/mrtg-mgt"
LOG_DIR="/var/log/apps"

DB_HOST=localhost
DB_NAME=mrtg_management
DB_USER=mrtg_user
DB_PASS="Pusing7Keliling"
DB_CHARSET=utf8mb4
DB_TIMEZONE=+07:00

# Storage MRTG
MRTG_BASE_DIR="/var/www/mrtg-mgt/storage/mrtg"
MRTG_CFG_DIR="/var/www/mrtg-mgt/storage/mrtg/cfg"
MRTG_HTML_DIR="/var/www/mrtg-mgt/storage/mrtg/html"
MRTG_IMG_DIR="/var/www/mrtg-mgt/storage/mrtg/images"
MRTG_LOG_DIR="/var/www/mrtg-mgt/storage/mrtg/log"

# SNMP CLI binaries
SNMPGET_BIN=/usr/bin/snmpget
SNMPWALK_BIN=/usr/bin/snmpwalk

# Diagnostics
PING_BIN=/bin/ping
TRACEROUTE_BIN=/usr/bin/traceroute
AUDIT_RETENTION_DAYS=30
SNMP_CHECK_LOG_RETENTION_DAYS=14

# Security/session
SESSION_COOKIE_NAME=mrtg_mgt_sid
SESSION_SECURE_COOKIE=0
SESSION_SAMESITE=Lax

# UI defaults
PAGINATION_PER_PAGE=20
